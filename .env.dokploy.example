# URLs publiques (sans slash final)
APP_BASE_PATH=
FRONTEND_URL=https://app.example.com
BACKEND_URL=https://api.example.com
NEXT_PUBLIC_FRONTEND_URL=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com/api

# Origines séparées par des virgules
ALLOWED_ORIGINS=https://app.example.com

# Services de données
DATABASE_URL=postgresql://user:password@host:5432/database
REDIS_PASSWORD=replace-with-a-long-random-password

# Authentification
JWT_SECRET=replace-with-at-least-64-random-characters
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# Protection HTTP Basic de Swagger
SWAGGER_USERNAME=voxo-docs
SWAGGER_PASSWORD=replace-with-a-long-random-password

# Supabase, si utilisé directement par l'application
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Fournisseurs IA : renseigner uniquement ceux utilisés
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307
ANTHROPIC_MAX_TOKENS=1000
OPENAI_API_KEY=
# Clé OpenAI directe (sk-proj-...) pour les embeddings uniquement. Laisser vide désactive
# la recherche sémantique au profit du lexical. N'y mettez JAMAIS la clé OpenRouter
# (sk-or-v1-...) : OpenRouter n'expose pas d'endpoint embeddings, chaque appel finit en 401.
OPENAI_DIRECT_KEY=
OPENAI_MODEL=gpt-3.5-turbo
TRANSCRIPTION_PROVIDER=openrouter
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_MIN_SIMILARITY=0.35
RAG_TOP_K=5

# Canaux optionnels
TELEGRAM_WEBHOOK_SECRET=

# Limites et support
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
SUPPORT_EMAIL=support@example.com

# Emailing transactionnel
# EMAIL_PROVIDER=brevo (API HTTP, par défaut) ou smtp (Nodemailer)
# La clé Brevo ne doit jamais être committée : la renseigner dans Dokploy uniquement.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=Voxo Chat

# Utilisé uniquement si EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
