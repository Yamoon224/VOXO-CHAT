{
  "name": "chatbot-saas-backend",
  "version": "1.0.0",
  "description": "Backend API pour chatbot SaaS multitenant",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:connections": "node src/utils/testConnection.js",
    "test:auth": "node src/scripts/testAuth.js",
    "test:api": "node src/scripts/testAllAPI.js",
    "test:knowledge": "node src/scripts/testKnowledge.js",
    "test:openai": "node src/scripts/testOpenAI.js",
    "test:claude": "node src/scripts/testClaude.js",
    "check:email": "node src/scripts/checkEmailConfig.js",
    "validate:swagger": "node src/scripts/validateSwagger.js",
    "test:swagger": "jest src/middleware/swaggerMiddleware.test.js --runInBand",
    "test:chat": "jest src/controllers/chatController.test.js --runInBand",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "storage:init": "node src/scripts/initStorageBucket.js",
    "attachments:purge": "node src/scripts/purgeOrphanAttachments.js",
    "catalogs:purge": "node src/scripts/purgeAbandonedCatalogs.js",
    "notifications:purge": "node src/scripts/purgeReadNotifications.js",
    "agent-usage:purge": "node src/scripts/purgeAgentTurnUsage.js",
    "commercial:retry-notifications": "node src/scripts/retryCommercialNotifications.js",
    "test:ocr": "jest src/services/ocrService.test.js --runInBand",
    "init:embeddings": "node src/scripts/initializeEmbeddings.js",
    "setup:ocr": "node src/scripts/setupOCR.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "db:sync": "node -e \"require('./src/config/database').sequelize.sync({force: true})\"",
    "logs": "tail -f logs/*.log"
  },
  "keywords": [
    "chatbot",
    "saas",
    "multitenant",
    "nodejs",
    "express",
    "claude",
    "anthropic",
    "ai",
    "file-processing",
    "knowledge-base",
    "ocr",
    "pdf-extraction",
    "document-processing"
  ],
  "author": "Wilfried KONAN",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.61.0",
    "@napi-rs/canvas": "^0.1.80",
    "@supabase/supabase-js": "^2.112.2",
    "@types/multer": "^2.0.0",
    "archiver": "^5.3.2",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "joi": "^18.0.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.10.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.5",
    "openai": "^5.12.2",
    "pdf-parse": "^1.1.1",
    "pdf2pic": "^3.2.0",
    "pdfjs-dist": "^5.4.149",
    "pdfkit": "^0.16.0",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "^6.0.1",
    "uuid": "^11.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.2.1",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^14.0.0",
    "jest": "^30.0.5",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "sequelize-cli": "^6.6.3",
    "supertest": "^7.1.4"
  }
}
