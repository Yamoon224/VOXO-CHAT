NODE_ENV=development
PORT=3000

# Base de données
DATABASE_URL=postgresql://chatbot_user:change-me@localhost:5432/chatbot_dev

# Cache
REDIS_URL=redis://localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=

# Authentification
JWT_SECRET=replace-with-at-least-64-random-characters
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# URLs et sécurité
ALLOWED_ORIGINS=http://localhost:3001
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:3000
SUPPORT_EMAIL=support@example.com

# Notifications push OneSignal (facultatif : les notifications in-app restent actives sans ces clés)
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Paiement Paystack — laissÃ© dÃ©sactivÃ© tant que les prix XOF et les clÃ©s ne sont
# pas prÃªts. Aucun checkout ni webhook n'est montÃ© par le backend Ã  ce stade.
PAYSTACK_ENABLED=false
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=
# PAYSTACK_BASE_URL=https://api.paystack.co

# Emailing transactionnel
# provider = brevo (API HTTP, par défaut) ou smtp (Nodemailer, fallback)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@votredomaine.com
BREVO_SENDER_NAME=Voxo Chat

# SMTP - utilisé uniquement si EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.votrefournisseur.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=Voxo Chat <no-reply@votredomaine.com>

# Documentation Swagger (facultatif en développement, requis en production)
SWAGGER_USERNAME=
SWAGGER_PASSWORD=

# Supabase, si utilisé
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stockage des fichiers uploadés (Supabase Storage).
# Nécessite SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY ci-dessus.
# Créer le bucket privé une fois avec : npm run storage:init
# Planifier chaque heure : npm run attachments:purge
SUPABASE_STORAGE_BUCKET=voxo-files
STORAGE_SIGNED_URL_TTL=300

# Fournisseurs IA
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307
ANTHROPIC_MAX_TOKENS=1000
OPENAI_API_KEY=
# Clé OpenAI directe (sk-proj-...) pour les embeddings uniquement. Laisser vide désactive
# la recherche sémantique au profit du lexical. N'y mettez JAMAIS la clé OpenRouter
# (sk-or-v1-...) : OpenRouter n'expose pas d'endpoint embeddings, chaque appel finit en 401.
OPENAI_DIRECT_KEY=
TRANSCRIPTION_PROVIDER=openrouter
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-1
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_VISION_MODEL=openai/gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_MIN_SIMILARITY=0.35
RAG_TOP_K=5

# Fonctionnalité "Agent" (actions API configurables par tenant, appelées par le
# chatbot). Clé de chiffrement des secrets stockés (auth_secret_encrypted) :
# générer avec `openssl rand -hex 32`, ne jamais réutiliser une clé d'un autre usage.
AGENT_ACTION_ENCRYPTION_KEY=
AGENT_ACTION_MAX_ITERATIONS=2
AGENT_ACTION_MAX_TOKENS_PER_TURN=6000
AGENT_ACTION_RESERVED_FINAL_TOKENS=512
AGENT_ACTION_RESERVED_CORRECTION_TOKENS=256
AGENT_ACTION_MAX_TOOL_CALLS_PER_TURN=4
AGENT_ACTION_MAX_TOOL_RESULT_CHARS=4096

# Canaux optionnels
# WhatsApp Cloud API (Meta) — values are entered per tenant in the dashboard.
WHATSAPP_GRAPH_API_URL=https://graph.facebook.com
WHATSAPP_GRAPH_API_VERSION=v22.0
WHATSAPP_TIMEOUT_MS=10000
TELEGRAM_WEBHOOK_SECRET=your_random_secret_here

# Intégrations : clé aléatoire, stable, d’au moins 32 caractères pour chiffrer les jetons au repos.
INTEGRATIONS_ENCRYPTION_KEY=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/integrations/microsoft/callback

# Géolocalisation des visiteurs (pays/ville affichés dans le panneau « Détails du client »)
# Mettre IP_GEOLOCATION_ENABLED=false pour ne jamais interroger de service tiers.
# Les IP privées/locales (::1, 192.168.x…) ne sont jamais résolues ; les en-têtes proxy
# (cf-ipcountry, x-geo-city) sont prioritaires quand ils existent.
IP_GEOLOCATION_ENABLED=true
IP_GEOLOCATION_URL=http://ip-api.com/json/{ip}?fields=status,country,countryCode,city,regionName,timezone&lang=fr

# Limites
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
UPLOAD_MAX_SIZE=10485760
