{
  "info": {
    "name": "Voxo Chat API",
    "description": "Collection complète pour tester les routes du backend Voxo Chat.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "tenantId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@test.com\",\n  \"password\": \"password123\",\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\",\n  \"tenantName\": \"Test Company\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@test.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "Tenant",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tenant/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tenant", "profile"]
            }
          }
        },
        {
          "name": "Update Settings",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"settings\": {\n    \"theme\": \"dark\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tenant/settings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tenant", "settings"]
            }
          }
        }
      ]
    },
    {
      "name": "Knowledge",
      "item": [
        {
          "name": "List Knowledge",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/knowledge",
              "host": ["{{baseUrl}}"],
              "path": ["api", "knowledge"]
            }
          }
        },
        {
          "name": "Create Knowledge",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Conditions générales\",\n  \"content\": \"Nos conditions générales stipulent que...\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/knowledge",
              "host": ["{{baseUrl}}"],
              "path": ["api", "knowledge"]
            }
          }
        }
      ]
    },
    {
      "name": "Chat (Dashboard)",
      "item": [
        {
          "name": "Send Message",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Bonjour\",\n  \"sessionId\": \"12345\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/chat/message",
              "host": ["{{baseUrl}}"],
              "path": ["api", "chat", "message"]
            }
          }
        },
        {
          "name": "Get Conversation",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/chat/conversation/12345",
              "host": ["{{baseUrl}}"],
              "path": ["api", "chat", "conversation", "12345"]
            }
          }
        }
      ]
    },
    {
      "name": "Widget (Public)",
      "item": [
        {
          "name": "Widget Config",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-ID", "value": "{{tenantId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/widget/config",
              "host": ["{{baseUrl}}"],
              "path": ["api", "widget", "config"]
            }
          }
        },
        {
          "name": "Widget Health",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-ID", "value": "{{tenantId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/widget/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "widget", "health"]
            }
          }
        },
        {
          "name": "Send Message",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Tenant-ID", "value": "{{tenantId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Bonjour, comment ça va ?\",\n  \"sessionId\": \"session-widget-1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/widget/message",
              "host": ["{{baseUrl}}"],
              "path": ["api", "widget", "message"]
            }
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        {
          "name": "Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/analytics/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["api", "analytics", "dashboard"]
            }
          }
        },
        {
          "name": "Detailed Stats",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/analytics/detailed",
              "host": ["{{baseUrl}}"],
              "path": ["api", "analytics", "detailed"]
            }
          }
        }
      ]
    }
  ]
}
