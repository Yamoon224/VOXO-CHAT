# Développement local
NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://chatbot_user:change-me@localhost:5432/chatbot_dev
REDIS_URL=redis://localhost:6379

JWT_SECRET=replace-with-a-long-random-secret
OPENAI_API_KEY=
# Clé OpenAI directe (sk-proj-...) pour les embeddings uniquement. Laisser vide désactive
# la recherche sémantique au profit du lexical. N'y mettez JAMAIS la clé OpenRouter
# (sk-or-v1-...) : OpenRouter n'expose pas d'endpoint embeddings, chaque appel finit en 401.
OPENAI_DIRECT_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# openrouter (recommandé pour les vocaux) ou openai (clé directe requise)
TRANSCRIPTION_PROVIDER=openrouter
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-1

# Médias entrants Telegram / WhatsApp
MEDIA_MAX_BYTES=10485760
MEDIA_MAX_VOICE_SECONDS=600
MEDIA_DOWNLOAD_TIMEOUT_MS=15000
MEDIA_TEMP_TTL_MS=3600000
PDF_MAX_PAGES=50
CATALOG_DRAFT_TTL_MS=86400000
OPENAI_CATALOG_VISION_MODEL=openai/gpt-4o-mini
OPENAI_CATALOG_VISION_FALLBACK_MODEL=openai/gpt-4o
CATALOG_EXTRACTION_MIN_CONFIDENCE=0.75

RAG_MIN_SIMILARITY=0.35
RAG_TOP_K=5
CONVERSATION_INACTIVITY_MINUTES=30
ANTHROPIC_API_KEY=

ALLOWED_ORIGINS=http://localhost:3001
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:3000

# Emailing transactionnel (brevo par défaut, smtp en fallback)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@votredomaine.com
BREVO_SENDER_NAME=Voxo Chat
SUPPORT_EMAIL=support@example.com

# Documentation Swagger (facultatif en développement)
SWAGGER_USERNAME=
SWAGGER_PASSWORD=

# Telegram : délai d'appel et politique de réessai des envois
TELEGRAM_TIMEOUT_MS=10000
TELEGRAM_SEND_MAX_ATTEMPTS=3
TELEGRAM_RETRY_BASE_DELAY_MS=500
TELEGRAM_RETRY_MAX_DELAY_MS=5000
