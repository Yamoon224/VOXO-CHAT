{
  "name": "chatbot-widget",
  "version": "1.0.0",
  "description": "Widget de chatbot intégrable avec Claude AI",
  "main": "dist/widget.iife.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:copy": "npm run build && node copy-to-backend.js",
    "preview": "vite preview",
    "serve": "http-server dist -p 8080 --cors",
    "test": "node --test test/*.test.js",
    "copy": "node copy-to-backend.js",
    "deploy": "npm run build && npm run copy && echo 'Widget déployé avec succès !'"
  },
  "keywords": [
    "chatbot",
    "widget",
    "claude",
    "ai",
    "javascript",
    "voxo",
    "saas",
    "customer-support"
  ],
  "author": "Wilfried KONAN",
  "license": "MIT",
  "devDependencies": {
    "http-server": "^14.1.1",
    "jsdom": "^26.1.0",
    "terser": "^5.44.0",
    "vite": "^5.0.0"
  },
  "files": [
    "dist/",
    "src/",
    "index.html",
    "vite.config.js",
    "copy-to-backend.js"
  ],
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie <= 11"
  ],
  "engines": {
    "node": ">=16.0.0"
  }
}
